{
  "name": "personal-learning-os",
  "private": true,
  "version": "0.1.0",
  "description": "An open-source, local-first AI learning system that turns your knowledge into an adaptive learning experience.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:i18n": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/i18n-alignment.test.ts",
    "test:goal": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/goal-repo.test.ts",
    "test:scope": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/chapter-scope.test.ts",
    "test:eta": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/plan-eta.test.ts",
    "test:import": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/import-core.test.ts",
    "test:extract": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/import-extract.test.ts",
    "test:storage": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/storage-adapter.test.ts",
    "test:anchor": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/library-anchor.test.ts",
    "test:advice": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/library-paper-advice.test.ts",
    "test:keypoint": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/library-keypoint.test.ts",
    "test:preview": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/library-chapter-preview.test.ts",
    "test:overview": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/library-overview.test.ts",
    "test:library": "npm run test:anchor && npm run test:advice && npm run test:keypoint && npm run test:preview && npm run test:overview",
    "test:chunk": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/chunk-engine.test.ts",
    "test:retrieval": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/retrieval.test.ts",
    "test:rag": "node --experimental-strip-types --no-warnings --import ./tests/register-loader.mjs tests/rag-wiring.test.ts",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}

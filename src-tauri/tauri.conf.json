{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Learning OS",
  "version": "0.1.0",
  "identifier": "com.jackxuyi.personal-learning-os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Personal Learning OS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [],
    "externalBin": ["binaries/llama-helper"]
  }
}
